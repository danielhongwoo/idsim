<?xml version="1.0" encoding="UTF-8"?>
<sdf version="1.9">
  <!--
    생성기 golden 전용 월드 템플릿. 실제 템플릿(ros_ws/src/idsim_sim/worlds/idsim_base.sdf)을
    고쳐도 golden이 바뀌지 않게 따로 둔다. 이 파일은 Gazebo로 열지 않는다.
  -->
  <world name="default">
    <physics type="ode">
      <max_step_size>0.004</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    <gravity>0 0 -9.8</gravity>
    <!-- 주석은 생성 결과에 그대로 남는다 -->
    <scene>
      <ambient>0.4 0.4 0.4 1</ambient>
      <shadows>true</shadows>
    </scene>
    <light type="directional" name="sunUTC">
      <pose>0 0 500 0 0 0</pose>
      <direction>0.001 0.625 -0.78</direction>
    </light>
    <spherical_coordinates>
      <surface_model>EARTH_WGS84</surface_model>
      <world_frame_orientation>ENU</world_frame_orientation>
      <latitude_deg>37.5665</latitude_deg>
      <longitude_deg>126.978</longitude_deg>
      <elevation>38</elevation>
      <heading_deg>0</heading_deg>
    </spherical_coordinates>
  </world>
</sdf>
