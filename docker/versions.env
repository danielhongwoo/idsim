# idsim 버전 단일 출처. Dockerfile, bake, compose, CI가 모두 이 파일을 읽는다.
# 이미지 key(tools/ci/image_keys.py)는 이미지의 Dockerfile이 ARG로 선언한 이름의 줄만 해시에 넣는다.
# 따라서 아래 CI 도구 줄을 바꿔도 이미지 key는 바뀌지 않는다.
# 베이스 이미지: ubuntu:24.04의 linux/amd64 manifest digest (조회일 2026-11-06)
UBUNTU_IMAGE=ubuntu:24.04@sha256:78d4744ead1f5b19b04d0df558ab182a5300903900755e515b2ca4d10eb2044d
# 우분투 apt 미러(archive와 security 둘 다 이 주소로 바뀐다). 이미지 key에 넣지 않는다. ubuntu.sources는 이미지에 남아
# 미러별로 바이트가 다르지만 런타임이 apt를 쓰지 않으므로 같은 이미지로 본다. http 주소만 쓴다(베이스에 CA 인증서가 없다)
# (tools/ci/image_keys.py의 KEY_EXCLUDED_ARGS). 결정 2026-11-10: 이 호스트에서 archive.ubuntu.com이 막혀 kr 미러로 둔다.
# 다른 값이 필요하면 같은 이름의 환경변수로 덮어쓴다 (docker/README.md 참고).
UBUNTU_APT_MIRROR=http://kr.archive.ubuntu.com/ubuntu
ROS_DISTRO=jazzy
# ros-ws에 apt로 설치하는 clang-tidy와 clang-format의 major(Ubuntu 24.04 기본). 더 새 major는 apt.llvm.org 저장소와 서명 key 지문이 필요하다
LLVM_MAJOR=18
# ros-ws에 apt로 설치하는 foxglove_bridge의 upstream 버전. ROS apt는 최신 빌드 하나만 남겨 정확한 pin이 불가하므로
# Dockerfile.ros-ws가 설치 뒤 dpkg 버전의 접두가 이 값인지 단정한다 (조회일 2026-11-11)
FOXGLOVE_BRIDGE_VERSION=3.6.0
# ROS apt 서명 key 지문. ros.key는 rosdistro master에서 받으므로 내용 대신 지문을 고정한다 (확인일 2026-11-06)
ROS_APT_KEY_FPR=C1CF6E31E6BADE8868B172B4F42ED6FBAB17C654
GZ_RELEASE=harmonic
# OSRF apt 서명 key 지문 (확인일 2026-11-06). Dockerfile.sim-base 반영 대기(sim-engineer)
GZ_APT_KEY_FPR=D2486D2DD83DB69272AFE98867170598AF249743
PX4_TAG=v1.17.0
# PX4-OpticalFlow master 커밋 (조회일 2026-11-06). px4 builder의 gz_plugins가 master를 받는 것을 고정하려는 값.
# Dockerfile.px4 반영 대기(px4-engineer)
PX4_OPTICAL_FLOW_REF=8758bd5567aadf2f8ab5deee97701d2c495d0756
# px4_msgs release/1.17 브랜치 HEAD (조회일 2026-11-06)
PX4_MSGS_REF=86d8239e962f6939e05c3737784f60c02fa884db
PX4_GZ_MODELS_REF=b6127f4ec20de867e215fb5f78ae88b80f371909
XRCE_AGENT_TAG=v2.4.3
# Agent v2.4.3 superbuild는 Fast-CDR 2.2.x, Fast-DDS 2.14.x 브랜치를 받는다. 그 브랜치 HEAD로 고정 (조회일 2026-11-06)
XRCE_FASTCDR_REF=757d5e422253568c487ad97c22e44680fc1ddbaf
XRCE_FASTDDS_REF=b904a7428b97da7ea2f5cab93488440bacbe3b8a
REGISTRY=ghcr.io/danielhongwoo/idsim
# px4_ros_com: release/1.17 브랜치가 없어 release/1.16 HEAD(= main과 같은 커밋)로 고정 (조회일 2026-11-06)
PX4_ROS_COM_REF=86e9aeb20e55a4673fa8a9f1c29ea06a6c5ad1af

# CI 린터 도구 (lint job과 tools/ci/lint.sh가 읽는다. 태그와 digest 함께 고정, 조회일 2026-11-06)
LINT_SHELLCHECK_IMAGE=koalaman/shellcheck:v0.11.0@sha256:61862eba1fcf09a484ebcc6feea46f1782532571a34ed51fedf90dd25f925a8d
LINT_HADOLINT_IMAGE=hadolint/hadolint:v2.15.1@sha256:32dac94127fd60b7b7e3fbfc65e1383b9b5e25c9bfd7b8536de7a539fe68a12d
LINT_ACTIONLINT_IMAGE=rhysd/actionlint:1.7.12@sha256:b1934ee5f1c509618f2508e6eb47ee0d3520686341fec936f3b79331f9315667
LINT_RUFF_IMAGE=ghcr.io/astral-sh/ruff:0.17.4@sha256:c4b7e7a87e4b07d66b569dd2e6b2ce5a25e38be91dd664dc49b9882be27acd9b
# yamllint와 pytest는 이 Python 이미지에 pip로 설치해 돌린다
LINT_PYTHON_IMAGE=python:3.12-slim@sha256:4840d514c583a4d3d8cad3940e68dee6f0f6f3635c12fcd0a3d74c21a5b93a54
LINT_YAMLLINT_VERSION=1.38.0
# clang-format은 lint job이 같은 Python 이미지에 pip로 설치해 돌린다. major는 LLVM_MAJOR와 같아야 하고(lint.sh가 단정한다),
# Ubuntu 24.04 release 포켓의 clang-format-18과 같은 패치 버전이다
LINT_CLANG_FORMAT_VERSION=18.1.3
LINT_PYTEST_VERSION=8.4.2
# 생성기 단위 테스트(tests/tools)용 PyYAML. ros-ws 이미지(Ubuntu 24.04 python3-yaml)의 버전과 같아야 하며 스모크 S0이 대조한다
LINT_PYYAML_VERSION=6.0.1

# QGroundControl (tools/qgc.sh가 읽는다. 어떤 Dockerfile의 ARG도 아니므로 이미지 key에 영향이 없다. 조회일 2026-11-09)
# 다운로드 URL: https://github.com/mavlink/qgroundcontrol/releases/download/<QGC_VERSION>/QGroundControl-x86_64.AppImage
# sha256은 내려받은 파일을 직접 계산한 값이며 릴리스 API의 digest와 같다.
QGC_VERSION=v5.1.5
QGC_APPIMAGE_SHA256=9a47e4cf269d9e4f897f582f6b19aa7ebf1e9e67c9d68a532a45b541354bc344
