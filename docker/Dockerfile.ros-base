# ros-base: Ubuntu + ROS 2 + CycloneDDS rmw + 공통 도구
ARG UBUNTU_IMAGE
FROM ${UBUNTU_IMAGE}

ARG ROS_DISTRO
ARG ROS_APT_KEY_FPR
RUN test -n "${ROS_DISTRO}" && test -n "${ROS_APT_KEY_FPR}" \
 || { echo "ROS_DISTRO, ROS_APT_KEY_FPR 빌드 인자가 비어 있다 (versions.env 확인)" >&2; exit 1; }

SHELL ["/bin/bash", "-o", "pipefail", "-c"]

ENV DEBIAN_FRONTEND=noninteractive \
    LANG=C.UTF-8 \
    ROS_DISTRO=${ROS_DISTRO} \
    RMW_IMPLEMENTATION=rmw_cyclonedds_cpp

# 우분투 apt 미러 (versions.env의 UBUNTU_APT_MIRROR). archive와 security를 모두 이 미러로 바꾼다.
# 이 단계에서 한 번 바꾸면 sim-base, px4, ros-ws가 이 이미지를 베이스로 상속한다.
# ros.list 등 서드파티 저장소는 건드리지 않는다.
ARG UBUNTU_APT_MIRROR
RUN test -n "${UBUNTU_APT_MIRROR}" || { echo "UBUNTU_APT_MIRROR 빌드 인자가 비어 있다 (versions.env 확인)" >&2; exit 1; } \
 && sed -i -E "s#https?://(archive|security)\.ubuntu\.com/ubuntu/?#${UBUNTU_APT_MIRROR%/}/#" /etc/apt/sources.list.d/ubuntu.sources \
 && grep -q "^URIs: ${UBUNTU_APT_MIRROR%/}/\$" /etc/apt/sources.list.d/ubuntu.sources

# ROS apt 저장소 등록 (Ubuntu 24.04 noble)
# ros.key는 rosdistro master에서 받는다. 만료일 연장으로 파일 내용은 바뀔 수 있으므로 URL을 커밋에
# 고정하지 않고, 받은 파일에 주 키가 하나뿐이며 그 지문이 versions.env의 ROS_APT_KEY_FPR과 같은지 검사한다.
RUN apt-get update \
 && apt-get install -y --no-install-recommends ca-certificates curl gnupg \
 && curl -fsSL https://raw.githubusercontent.com/ros/rosdistro/master/ros.key \
      -o /usr/share/keyrings/ros-archive-keyring.gpg \
 && gnupg_home="$(mktemp -d)" \
 && fpr="$(GNUPGHOME="${gnupg_home}" gpg --show-keys --with-colons /usr/share/keyrings/ros-archive-keyring.gpg \
      | awk -F: '$1 == "pub" { n++; want = 1; next } $1 == "fpr" && want { print; want = 0 } END { if (n != 1) exit 1 }' \
      | cut -d: -f10)" \
 && rm -rf "${gnupg_home}" \
 && echo "ros.key fingerprint=${fpr} expected=${ROS_APT_KEY_FPR}" \
 && test "${fpr}" = "${ROS_APT_KEY_FPR}" \
 && echo "deb [arch=amd64 signed-by=/usr/share/keyrings/ros-archive-keyring.gpg] http://packages.ros.org/ros2/ubuntu noble main" \
      > /etc/apt/sources.list.d/ros2.list \
 && rm -rf /var/lib/apt/lists/*

RUN apt-get update \
 && apt-get install -y --no-install-recommends \
      "ros-${ROS_DISTRO}-ros-base" \
      "ros-${ROS_DISTRO}-rmw-cyclonedds-cpp" \
      iproute2 \
      python3-pytest \
      procps \
      less \
 && rm -rf /var/lib/apt/lists/*

# bash -l 로그인 셸에서도 ROS 환경이 잡히도록 한다
RUN echo "source /opt/ros/${ROS_DISTRO}/setup.bash" > /etc/profile.d/ros.sh

CMD ["bash"]
